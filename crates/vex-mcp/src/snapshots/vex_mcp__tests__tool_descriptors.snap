    "name": "callees"
  },
  {
    "description": "Structural AST pattern matching: match code by shape, not text. Metavars: `$NAME` captures an identifier or balanced expression, `$_` is a wildcard, `$$$` is an anonymous ellipsis, `$$$NAME` / `$$NAME` is a named ellipsis that captures multi-line bodies or arg lists, repeated metavars enforce back-reference equality. Composition: space-flanked ` && ` and ` || ` join sub-patterns (AND requires both shapes in the file with shared captures agreeing; OR takes the union). Prefer over grep / ast-grep for cross-language structural queries — grep cannot match nested syntax, and ast-grep needs per-language scripts; vex pattern works on the cached tree-sitter parse with a skeleton prefilter (~10-50ms). Set `why: true` to inspect indexed vs live-scan mode.",
    "inputSchema": {
      "properties": {
        "exclude": {
          "description": "Blacklist results by path glob; wins over include (repeatable)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "description": "Whitelist results by path glob, gitignore syntax (repeatable)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lang": {
          "description": "Language: rust, python, typescript, go, java, csharp, ruby, kotlin, swift, cpp, php, sql, markdown",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "description": "Max matches to return",
          "type": "integer"
        },
        "pattern": {
          "description": "Structural pattern with $METAVARS (e.g. `fn $NAME($$ARGS) -> Result<$T, $E> { $$$BODY }`, `interface $N || class $N`). NOT regex — see grep for regex.",
          "type": "string"
        },
        "project_root": {
          "description": "Absolute path to the project root (defaults to the MCP working directory)",
          "type": "string"
        },
        "why": {
          "description": "Surface a ScanTrace under `_meta.why` in the response: mode (indexed/live_scan), root_kind_inferred, candidate_files / total_files, fallback_reason.",
          "type": "boolean"
        }
      },
      "required": [
        "pattern",
        "lang"
      ],
      "type": "object"
    },
    "name": "pattern"
  },
  {
    "description": "Symbol-level diff between a git revision and the working tree: lists added / removed / moved / body-changed symbols on the touched files. Prefer over `git diff` + manual scanning for PR review — git diff returns line hunks while this returns structured symbol records, so an agent can iterate over changed-functions directly instead of parsing unified-diff text.",
    "inputSchema": {
      "properties": {
        "base": {
          "description": "Git revision to compare against (e.g. main, HEAD~3, origin/main). Working tree is the new side.",
          "type": "string"
        },
        "exclude": {
          "description": "Blacklist changes by path glob; wins over include (repeatable)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "description": "Whitelist changes by path glob, gitignore syntax (repeatable)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": 500,
          "description": "Max changes to return",
          "type": "integer"
        },
        "project_root": {
          "description": "Absolute path to the project root (defaults to the MCP working directory)",
          "type": "string"
        }
      },
      "required": [
        "base"
      ],
      "type": "object"
    },
    "name": "diff"
  },
  {
    "description": "Enumerate every caller chain from `from` to `to` in the persistent call graph (multi-hop, max 6 by default). Prefer over repeated `callers` calls when you need to know how a function gets reached from a known entry point — paths walks the edges itself in a single response. Requires a v4 index with call graph (built without `--no-call-graph`).",
    "inputSchema": {
      "properties": {
        "auto_update": {
          "default": true,
          "description": "Auto-update the index if stale, or bootstrap it if missing, before running (default: true)",
          "type": "boolean"
        },
        "exclude": {
          "description": "Blacklist intermediate steps by path glob; wins over include (repeatable)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "from": {
          "description": "Exact name of the starting function (caller / entry point).",
          "type": "string"
        },
        "include": {
          "description": "Whitelist intermediate steps by path glob, gitignore syntax (repeatable)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_hops": {
          "default": 6,
          "description": "Maximum hops between from and to",
          "type": "integer"
        },
        "max_paths": {
          "default": 50,
          "description": "Maximum paths to enumerate (caps output, aborts traversal early)",
          "type": "integer"
        },
        "project_root": {
          "description": "Absolute path to the project root (defaults to the MCP working directory)",
          "type": "string"
        },
        "to": {
          "description": "Exact name of the destination function (callee being investigated).",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "name": "paths"
  },
  {
    "description": "Every symbol that transitively calls `target` (the full upstream blast radius). Prefer over repeated `callers` walks when assessing the impact of changing a function — reachable does the closure in one call. Requires a v4 index with call graph.",
    "inputSchema": {
      "properties": {
        "auto_update": {
          "default": true,
          "description": "Auto-update the index if stale, or bootstrap it if missing, before running (default: true)",
          "type": "boolean"
        },
        "exclude": {
          "description": "Blacklist results by path glob; wins over include (repeatable)",
