            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": 200,
          "description": "Max results",
          "type": "integer"
        },
        "max_hops": {
          "default": 6,
          "description": "Maximum hops to walk back from target",
          "type": "integer"
        },
        "project_root": {
          "description": "Absolute path to the project root (defaults to the MCP working directory)",
          "type": "string"
        },
        "target": {
