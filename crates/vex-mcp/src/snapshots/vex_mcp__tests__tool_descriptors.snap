---
source: crates/vex-mcp/src/main.rs
expression: descriptors
---
[
  {
    "description": "Hybrid structural + semantic code search across the indexed codebase. Fuses FST exact + BM25 + semantic channels in a single ranked list (~4ms FST hit, ~7-15ms with semantic). Prefer over grep for symbol or identifier lookup — grep does a full-scan (seconds on large repos) and returns line matches; this returns ranked symbol records with kind, signature, and line ranges. Use this when you need to find a definition by name, signature shape, or meaning rather than guessing a regex.",
    "inputSchema": {
      "properties": {
        "async_only": {
          "default": false,
          "description": "Keep only async/suspend functions",
          "type": "boolean"
        },
        "auto_update": {
          "default": true,
          "description": "Auto-update the index if stale, or bootstrap it if missing, before running (default: true)",
          "type": "boolean"
        },
        "exclude": {
          "description": "Blacklist results by path glob (wins over include); repeat for multiple globs",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "description": "Whitelist results by path glob, gitignore syntax (e.g. 'tests/**'); repeat for multiple globs",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": 20,
          "description": "Max results",
          "type": "integer"
        },
        "no_async": {
          "default": false,
          "description": "Exclude async/suspend functions",
          "type": "boolean"
        },
        "project_root": {
          "description": "Absolute path to the project root (defaults to the MCP working directory)",
          "type": "string"
        },
        "query": {
          "description": "Free-text query: symbol name, partial name, signature snippet, or natural-language description. Not for regex (use grep) or exact-only resolution (use find_symbol).",
          "type": "string"
        },
        "sealed_only": {
          "default": false,
          "description": "Keep only sealed (or Java-`final`) types",
          "type": "boolean"
        },
        "semantic": {
          "default": false,
          "description": "Enable the semantic vector channel (requires `vex index --semantic`); adds ~3-10ms but lets natural-language queries hit",
          "type": "boolean"
        },
        "static_only": {
          "default": false,
          "description": "Keep only static class members",
          "type": "boolean"
        },
        "visibility": {
          "description": "Keep only symbols whose signature contains this explicit visibility keyword (no inferred defaults)",
          "enum": [
            "public",
            "private",
            "protected",
            "internal"
          ],
          "type": "string"
        },
        "why": {
          "default": false,
          "description": "Surface a JSON trace under `_meta.why` in the response: normalized query, per-channel hits (FST/BM25/semantic/fuzzy), filter_applied snapshot",
          "type": "boolean"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "name": "search"
  },
  {
    "description": "Resolve a symbol by exact name (with prefix fallback) against the FST inverted index (~4ms). Prefer over search when the symbol name is known and you want exactly that record back, not a fused-rank list. Prefer over grep for `git grep 'class Foo'`-style definition lookup — grep scans every byte; this is a constant-time index probe.",
    "inputSchema": {
      "properties": {
        "auto_update": {
          "default": true,
          "description": "Auto-update the index if stale, or bootstrap it if missing, before running (default: true)",
          "type": "boolean"
        },
        "exclude": {
          "description": "Blacklist results by path glob; wins over include (repeatable)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "description": "Whitelist results by path glob, gitignore syntax (repeatable)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "DEPRECATED — use `symbol`. Pre-v1.7 alias, still accepted; emits a deprecated_args notice in _meta.",
          "type": "string"
        },
        "project_root": {
          "description": "Absolute path to the project root (defaults to the MCP working directory)",
          "type": "string"
        },
        "symbol": {
          "description": "Exact symbol name (function/class/struct/etc.) — canonical key (v1.7+). Use search for partial or fuzzy names.",
          "type": "string"
        }
      },
      "required": [
        "symbol"
      ],
      "type": "object"
    },
    "name": "find_symbol"
  },
  {
    "description": "Semantic-only search by natural-language description (e.g. 'payment processing' → ChargeUseCase, BillingService). Uses the HNSW vector index built by `vex index --semantic` (~7-15ms). Prefer over search when you do not know any concrete identifier and want concept-level matching; prefer search when you have a partial name (search fuses semantic + lexical channels for better recall on identifier-shaped queries).",
    "inputSchema": {
      "properties": {
        "auto_update": {
          "default": true,
          "description": "Auto-update the index if stale, or bootstrap it if missing, before running (default: true)",
          "type": "boolean"
        },
        "exclude": {
          "description": "Blacklist results by path glob; wins over include (repeatable)",
