          "type": "array"
        },
        "project_root": {
          "description": "Absolute path to the project root (defaults to the MCP working directory)",
          "type": "string"
        },
        "query": {
          "description": "Natural-language description of the concept (not an identifier; use find_symbol for those).",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "name": "find_similar"
  },
  {
    "description": "List every symbol (kind + line range) in a single source file via cached tree-sitter parse. Prefer over Read when you only need the file's structure (what's in here?) rather than the full byte stream — outline returns ~50 lines of structured records vs reading thousands of lines of source.",
    "inputSchema": {
      "properties": {
        "file": {
          "description": "DEPRECATED — use `path`. Pre-v1.7 alias, still accepted; emits a deprecated_args notice in _meta.",
          "type": "string"
        },
        "path": {
          "description": "Filesystem path to the source file — canonical key (v1.7+). Absolute or relative to project_root.",
          "type": "string"
        },
        "project_root": {
          "description": "Absolute path to the project root (defaults to the MCP working directory)",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "outline"
  },
  {
    "description": "Build or rebuild the vex index from scratch. Run once per project; use `update` afterward for incremental refreshes. Set semantic=true to also generate embeddings (slower; required for find_similar / similar / duplicates).",
    "inputSchema": {
      "properties": {
        "project_root": {
          "description": "Absolute path to the project root to index",
          "type": "string"
        },
        "semantic": {
          "default": false,
          "description": "Also generate per-symbol embeddings (enables semantic search / similar / duplicates; adds ~30-90s on a medium repo)",
          "type": "boolean"
        }
      },
      "required": [
        "project_root"
      ],
      "type": "object"
    },
    "name": "index"
  },
  {
    "description": "Incremental index refresh: only re-parses files whose mtime changed since the last index. Prefer over `index` when an index already exists — typically <1s on small change sets vs full rebuild cost. Most other tools default to auto_update=true and call this implicitly.",
    "inputSchema": {
      "properties": {
        "project_root": {
          "description": "Absolute path to the project root whose index should be refreshed",
          "type": "string"
        },
        "semantic": {
          "default": false,
          "description": "Also refresh embeddings for changed files",
          "type": "boolean"
        }
      },
      "required": [
        "project_root"
      ],
      "type": "object"
    },
    "name": "update"
  },
  {
    "description": "Report index statistics: symbol count, byte size, embedding presence, last-update timestamp. Use to confirm an index exists and is fresh before running search-shaped tools.",
    "inputSchema": {
      "properties": {
        "project_root": {
          "description": "Absolute path to the project root (defaults to the MCP working directory)",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "status"
  },
  {
    "description": "Extract the full source body of one or more symbols by name (function, class, struct, etc.) using cached symbol byte-offsets (~4ms per symbol). Prefer over Read when you need a specific definition — show returns just that body, while Read pulls the entire file (often 10-100x more tokens). Accepts an array, so a single call replaces several Read calls.",
    "inputSchema": {
      "properties": {
        "auto_update": {
          "default": true,
          "description": "Auto-update the index if stale, or bootstrap it if missing, before running (default: true)",
          "type": "boolean"
        },
        "exclude": {
          "description": "Blacklist results by path glob; wins over include (repeatable)",
