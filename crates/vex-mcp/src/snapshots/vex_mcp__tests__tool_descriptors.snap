          "type": "array"
        },
        "limit": {
          "default": 1,
          "description": "Max bodies returned per symbol name (handles overloads / duplicates)",
          "type": "integer"
        },
        "project_root": {
          "description": "Absolute path to the project root (defaults to the MCP working directory)",
          "type": "string"
        },
        "symbol": {
          "description": "DEPRECATED — use `symbols: [name]`. Pre-v1.7 singular alias, still accepted; emits a deprecated_args notice in _meta.",
          "type": "string"
